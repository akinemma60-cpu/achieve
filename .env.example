# ACHIEVE environment variables
# Copy this file to .env and fill in your values.

# Supabase project (required for all features)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI coaching and roadmap generation (required for AI features)
# These are server-side only — never expose them in the browser or VITE_ variables.
# Set these in Supabase Edge Function secrets, not in .env:
#   OPENAI_API_KEY=sk-...
#   APP_ORIGIN=http://localhost:5173
#   OPENAI_MODEL=gpt-4o-mini (optional, defaults to gpt-4o-mini)